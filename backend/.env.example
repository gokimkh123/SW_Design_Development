# 이 파일을 backend/.env 로 복사해서 쓴다. (.env는 커밋 금지)
# API 키는 건한에게 비공개 채널로 받는다.

ANTHROPIC_API_KEY=

# LLM 설정
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
# 동시에 보내는 LLM 요청 수 상한
LLM_MAX_CONCURRENCY=8

# 시뮬레이션 실행 방식: agents | single | replay
SIM_MODE=agents
# replay 모드에서 발화 사이 간격(ms)
REPLAY_DELAY_MS=600

# DB
DATABASE_URL=sqlite:///./roommate.db
