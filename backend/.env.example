# backend/.env로 복사하여 사용 (.env 커밋 금지)
# 로컬 개발은 ENGINE_IMPL=fake로 API 키 없이 진행 (실제 키는 VM ~/roommate/.env에만 보관)
# 실제 엔진 테스트 필요 시 건한이 사용 한도를 건 개인별 키 발급 · 작업 종료 후 폐기

ANTHROPIC_API_KEY=

# LLM 설정
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
# 동시 LLM 요청 수 상한
LLM_MAX_CONCURRENCY=8

# 엔진 구현: fake(백엔드 임시 가짜 엔진, LLM 미호출) | real(engine 패키지)
ENGINE_IMPL=fake

# live 시뮬레이션 실행 방식: agents | single (replay는 요청 mode로 지정)
SIM_MODE=agents
# replay 모드 발화 간격(ms)
REPLAY_DELAY_MS=600

# DB
DATABASE_URL=sqlite:///./roommate.db
