# backend/.env로 복사하여 사용 (.env 커밋 금지)
# API 키는 건한으로부터 비공개 채널로 수령

ANTHROPIC_API_KEY=

# LLM 설정
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
# 동시 LLM 요청 수 상한
LLM_MAX_CONCURRENCY=8

# 엔진 구현: fake(백엔드 임시 가짜 엔진, LLM 미호출) | real(engine 패키지)
ENGINE_IMPL=fake

# live 시뮬레이션 실행 방식: agents | single (replay는 요청 mode로 지정)
SIM_MODE=agents
# replay 모드 발화 간격(ms)
REPLAY_DELAY_MS=600

# DB
DATABASE_URL=sqlite:///./roommate.db
